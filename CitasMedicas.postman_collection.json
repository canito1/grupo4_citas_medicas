                  "pm.test('El médico se elimina con 204 No Content', function () { pm.response.to.have.status(204); pm.expect(pm.response.text()).to.eql(''); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirmar médico eliminado",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/medicos/{{medicoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El médico eliminado responde 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
