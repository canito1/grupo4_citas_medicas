{
  "info": {
    "_postman_id": "citas-medicas-api-v1",
    "name": "Citas Médicas API - Validaciones y pruebas REST",
    "description": "Colección de pruebas de integración para Pacientes, Médicos y Citas. Ejecutar los requests en orden con Collection Runner; los IDs se guardan automáticamente. Cambia la variable baseUrl si la API usa otro puerto.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "pacienteId",
      "value": ""
    },
    {
      "key": "medicoId",
      "value": ""
    },
    {
      "key": "citaId",
      "value": ""
    },
    {
      "key": "fechaCita",
      "value": ""
    },
    {
      "key": "dniPaciente",
      "value": ""
    },
    {
      "key": "emailPaciente",
      "value": ""
    },
    {
      "key": "colegiaturaMedico",
      "value": ""
    },
    {
      "key": "emailMedico",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Pacientes",
      "item": [
        {
          "name": "Listar pacientes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/pacientes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('El cuerpo es una lista', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener paciente existente",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/pacientes/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 y devuelve un paciente', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().id).to.eql(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear paciente válido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"María\",\n  \"apellido\": \"Ramos\",\n  \"dni\": \"{{dniPaciente}}\",\n  \"telefono\": \"999888777\",\n  \"email\": \"{{emailPaciente}}\",\n  \"fechaNacimiento\": \"1995-03-10T00:00:00\"\n}"
            },
            "url": "{{baseUrl}}/api/pacientes"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var suffix = String(Date.now()).slice(-8);",
                  "pm.collectionVariables.set('dniPaciente', suffix);",
                  "pm.collectionVariables.set('emailPaciente', 'maria.ramos.' + suffix + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Devuelve y guarda el ID del paciente', function () { var data = pm.response.json(); pm.expect(data.id).to.be.a('number'); pm.expect(data.dni).to.eql(pm.collectionVariables.get('dniPaciente')); pm.collectionVariables.set('pacienteId', data.id); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Validar paciente con datos inválidos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"A\",\n  \"apellido\": \"\",\n  \"dni\": \"123\",\n  \"telefono\": \"teléfono inválido\",\n  \"email\": \"correo-inválido\",\n  \"fechaNacimiento\": \"1995-03-10T00:00:00\"\n}"
            },
            "url": "{{baseUrl}}/api/pacientes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La validación responde 400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "pm.test('La respuesta incluye errores de validación', function () { pm.expect(pm.response.json()).to.have.property('errors'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Rechazar DNI duplicado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Paciente\",\n  \"apellido\": \"Duplicado\",\n  \"dni\": \"12345678\",\n  \"telefono\": \"900000000\",\n  \"email\": \"duplicado@example.com\",\n  \"fechaNacimiento\": \"1990-01-01T00:00:00\"\n}"
            },
            "url": "{{baseUrl}}/api/pacientes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El DNI duplicado responde 409 Conflict', function () { pm.response.to.have.status(409); });",
                  "pm.test('El error tiene el formato estándar', function () { var data = pm.response.json(); pm.expect(data.status).to.eql(409); pm.expect(data).to.have.property('mensaje'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar paciente creado",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"María Elena\",\n  \"apellido\": \"Ramos\",\n  \"dni\": \"45678901\",\n  \"telefono\": \"999888777\",\n  \"email\": \"maria.ramos.postman@example.com\",\n  \"fechaNacimiento\": \"1995-03-10T00:00:00\"\n}"
            },
            "url": "{{baseUrl}}/api/pacientes/{{pacienteId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 y actualiza el paciente', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().nombre).to.eql('María Elena'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar paciente inexistente",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/pacientes/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 404 Not Found', function () { pm.response.to.have.status(404); });",
                  "pm.test('El error identifica el recurso', function () { var data = pm.response.json(); pm.expect(data.status).to.eql(404); pm.expect(data.error).to.eql('NotFound'); });"
                ]
              }
            }
          ]
        }
      ]
    },
